<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sb_bg">

    <!-- boxedEdges="all" 讓內容縮進圓形錶面的內接正方形，圓錶方錶都不會被切到 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:boxedEdges="all">

        <!-- 連線狀態；連上之後改顯示「● 第N局 x:y」 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="連線中…"
            android:textColor="@color/sb_muted"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 色塊本身可點：點一下或上滑 +1。−1 按鈕疊在色塊底部內側，
                 它自己 clickable，所以點 −1 不會被色塊當成加分。 -->
            <LinearLayout
                android:id="@+id/panelA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_team_a"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvNameA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="A"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

                <!-- autoSize：錶面大小差很多（192dp～234dp），固定字級不是太小就是被切，
                     讓字級自己去填剩下的高度最省事 -->
                <TextView
                    android:id="@+id/tvScoreA"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="46sp"
                    android:autoSizeStepGranularity="1sp" />

                <TextView
                    android:id="@+id/btnMinusA"
                    android:layout_width="52dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_deduct"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−1"
                    android:textColor="#D1FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/panelB"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_team_b"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvNameB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="B"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvScoreB"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="46sp"
                    android:autoSizeStepGranularity="1sp" />

                <TextView
                    android:id="@+id/btnMinusB"
                    android:layout_width="52dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_deduct"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−1"
                    android:textColor="#D1FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 計時留在手機端操作；手錶底部只保留重置，按鈕因此可以做大一點 -->
        <TextView
            android:id="@+id/btnReset"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_ctrl"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="↺"
            android:textColor="@color/sb_text"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.wear.widget.BoxInsetLayout>
