# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
# 只忽略建置產出；模組本身（5 個小檔，共 11K）必須進版控，因為 settings.gradle
# 有 include ':capacitor-cordova-android-plugins'，少了它 gradle 建置直接失敗。
capacitor-cordova-android-plugins/build/

# Copied web assets
# 網頁本體由 gradle 的 copyWebAssets task 從專案根目錄複製進來（見 app/build.gradle）。
# 但 cordova.js / cordova_plugins.js 是 Capacitor 產生的、根目錄沒有的檔
# （本專案無 cordova plugin，兩個都是 0 byte），若不進版控，CI 從乾淨 checkout
# 建置出的 APK 就會缺這兩個檔，所以在此例外放行。
app/src/main/assets/public/*
!app/src/main/assets/public/cordova.js
!app/src/main/assets/public/cordova_plugins.js

# Generated Config files
# 這三個檔由 npx cap sync 產生。本專案的 CI 不跑 node（只做網頁複製後直接 gradle
# 建置），所以必須進版控。日後新增／移除 Capacitor plugin 後，記得跑 npx cap sync
# 並把這三個檔的變更一起 commit。
#   app/src/main/assets/capacitor.config.json
#   app/src/main/assets/capacitor.plugins.json
#   app/src/main/res/xml/config.xml
